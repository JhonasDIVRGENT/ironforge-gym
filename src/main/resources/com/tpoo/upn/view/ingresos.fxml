<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.tpoo.upn.gui.IngresosViewController" styleClass="contenido">

    <VBox styleClass="panel">
        <HBox spacing="8">
            <Label text="RECEPCIÓN" styleClass="chip"/>
        </HBox>
        <Label text="Registrar ingreso" styleClass="titulo-modulo"/>
        <Label text="Busque al cliente por DNI o selecciónelo de la lista. El sistema verifica su membresía al registrar el ingreso."
               styleClass="descripcion" wrapText="true"/>
    </VBox>

    <HBox spacing="20">
        <!-- Busqueda del cliente -->
        <VBox styleClass="panel" prefWidth="330" minWidth="280">
            <Label text="DNI DEL CLIENTE (8 DÍGITOS)" styleClass="etiqueta"/>
            <TextField fx:id="txtDni" promptText="00000000" styleClass="campo-mono" onAction="#buscarPorDni"/>
            <HBox spacing="8">
                <Button minWidth="-Infinity" fx:id="btnConsultar" text="Consultar" styleClass="boton-primario"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#buscarPorDni"/>
                <Button minWidth="-Infinity" text="Limpiar" styleClass="boton-secundario"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#limpiar"/>
            </HBox>
            <Separator/>
            <Label text="O SELECCIONE DE LA LISTA" styleClass="etiqueta"/>
            <ComboBox fx:id="cmbClientes" promptText="Seleccione un cliente" maxWidth="Infinity"
                      onAction="#seleccionarDeLista"/>
            <Label fx:id="lblMensaje" styleClass="mensaje" maxWidth="Infinity" wrapText="true"
                   visible="false" managed="false"/>
        </VBox>

        <!-- Datos del cliente y registro del ingreso -->
        <VBox styleClass="panel" HBox.hgrow="ALWAYS" minWidth="410">
            <VBox fx:id="panelVacio" spacing="6">
                <Label text="Esperando consulta" styleClass="titulo-panel" minWidth="-Infinity"/>
                <Label text="Ingrese un DNI o seleccione un cliente para ver sus membresías."
                       styleClass="descripcion" wrapText="true"/>
            </VBox>

            <VBox fx:id="panelCliente" spacing="14" visible="false" managed="false">
                <VBox spacing="4">
                    <Label text="CLIENTE" styleClass="etiqueta"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label fx:id="lblNombre" styleClass="dato-grande" wrapText="true"/>
                        <Label fx:id="lblDni" styleClass="chip"/>
                    </HBox>
                    <Label fx:id="lblTelefono" styleClass="descripcion"/>
                </VBox>
                <Label fx:id="lblResumen" styleClass="chip"/>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="MEMBRESÍAS" styleClass="etiqueta"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <!-- Solo aparece si el cliente tiene periodos vencidos -->
                    <CheckBox fx:id="chkHistorial" text="Mostrar historial" minWidth="-Infinity"
                              visible="false" managed="false" onAction="#cambiarHistorial"/>
                </HBox>
                <TableView fx:id="tblMembresias" prefHeight="190">
                    <columns>
                        <TableColumn fx:id="colTipo" text="TIPO" prefWidth="150" minWidth="80"/>
                        <TableColumn fx:id="colInicio" text="INICIO" prefWidth="110" minWidth="90"/>
                        <TableColumn fx:id="colFin" text="VENCIMIENTO" prefWidth="110" minWidth="95"/>
                        <TableColumn fx:id="colEstado" text="ESTADO" prefWidth="130" minWidth="115"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                    </columnResizePolicy>
                    <placeholder>
                        <Label fx:id="lblSinMembresias" text=""/>
                    </placeholder>
                </TableView>

                <Button minWidth="-Infinity" fx:id="btnRegistrar" text="Registrar ingreso" styleClass="boton-primario, boton-grande"
                        maxWidth="Infinity" onAction="#registrarIngreso"/>
                <Label text="El empleado que registra y la fecha y hora se toman automáticamente de la sesión y del reloj del sistema."
                       styleClass="etiqueta" wrapText="true"/>
                <Label fx:id="lblMensajeIngreso" styleClass="mensaje" maxWidth="Infinity" wrapText="true"
                       visible="false" managed="false"/>

                <VBox fx:id="panelResultado" styleClass="resultado-ok" visible="false" managed="false">
                    <Label text="INGRESO REGISTRADO" styleClass="etiqueta"/>
                    <Label fx:id="lblResultadoFecha" styleClass="dato-grande"/>
                    <Label fx:id="lblResultadoDetalle" styleClass="descripcion" wrapText="true"/>
                </VBox>
            </VBox>
        </VBox>
    </HBox>
</VBox>
