<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.tpoo.upn.gui.ConsultasViewController" styleClass="contenido">

    <VBox styleClass="panel">
        <HBox spacing="8">
            <Label text="ADMINISTRACIÓN" styleClass="chip"/>
        </HBox>
        <Label text="Consultas" styleClass="titulo-modulo"/>
        <Label text="Historial de ingresos de un cliente y membresías vigentes próximas a vencer."
               styleClass="descripcion" wrapText="true"/>
    </VBox>

    <TabPane tabClosingPolicy="UNAVAILABLE">
        <Tab text="Historial de ingresos">
            <VBox styleClass="panel">
                <Label text="CLIENTE" styleClass="etiqueta"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <ComboBox fx:id="cmbClientes" promptText="Seleccione un cliente" maxWidth="Infinity"
                              HBox.hgrow="ALWAYS"/>
                    <Button minWidth="-Infinity" fx:id="btnHistorial" text="Consultar historial" styleClass="boton-primario"
                            onAction="#consultarHistorial"/>
                </HBox>
                <Label fx:id="lblMensajeHistorial" styleClass="mensaje" maxWidth="Infinity" wrapText="true"
                       visible="false" managed="false"/>
                <Label fx:id="lblResumenHistorial" styleClass="etiqueta"/>
                <TableView fx:id="tblHistorial" prefHeight="320">
                    <columns>
                        <TableColumn fx:id="colFechaHora" text="FECHA Y HORA" prefWidth="170"/>
                        <TableColumn fx:id="colRegistradoPor" text="REGISTRADO POR" prefWidth="150"/>
                        <TableColumn fx:id="colMembresia" text="MEMBRESÍA USADA" prefWidth="160"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                    </columnResizePolicy>
                    <placeholder>
                        <Label fx:id="lblSinHistorial" text="Seleccione un cliente y pulse Consultar historial."/>
                    </placeholder>
                </TableView>
            </VBox>
        </Tab>

        <Tab text="Próximas a vencer">
            <VBox styleClass="panel">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Membresías vigentes que vencen entre hoy y los próximos 7 días."
                           styleClass="descripcion" wrapText="true"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button minWidth="-Infinity" fx:id="btnActualizar" text="Actualizar" styleClass="boton-secundario"
                            onAction="#consultarPorVencer"/>
                </HBox>
                <Label fx:id="lblMensajeVencer" styleClass="mensaje" maxWidth="Infinity" wrapText="true"
                       visible="false" managed="false"/>
                <TableView fx:id="tblPorVencer" prefHeight="320">
                    <columns>
                        <TableColumn fx:id="colCliente" text="CLIENTE" prefWidth="200"/>
                        <TableColumn fx:id="colDni" text="DNI" prefWidth="100"/>
                        <TableColumn fx:id="colTipo" text="TIPO" prefWidth="130"/>
                        <TableColumn fx:id="colVence" text="VENCE" prefWidth="110"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                    </columnResizePolicy>
                    <placeholder>
                        <Label fx:id="lblSinPorVencer" text=""/>
                    </placeholder>
                </TableView>
            </VBox>
        </Tab>
    </TabPane>
</VBox>
