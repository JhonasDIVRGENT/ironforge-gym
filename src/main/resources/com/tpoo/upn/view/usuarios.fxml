<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.tpoo.upn.gui.UsuariosViewController" styleClass="contenido">

    <VBox styleClass="panel">
        <HBox spacing="8">
            <Label text="ADMINISTRACIÓN" styleClass="chip"/>
        </HBox>
        <Label text="Usuarios" styleClass="titulo-modulo"/>
        <Label text="Cree cuentas del personal y active o desactive cuentas mediante su nombre de usuario."
               styleClass="descripcion" wrapText="true"/>
    </VBox>

    <HBox spacing="20">
        <!-- RF-13: crear cuenta -->
        <VBox styleClass="panel" HBox.hgrow="ALWAYS" minWidth="380">
            <HBox styleClass="panel-cabecera">
                <Label text="Crear cuenta" styleClass="titulo-panel" minWidth="-Infinity"/>
            </HBox>
            <Label fx:id="lblMensajeCrear" styleClass="mensaje" maxWidth="Infinity" wrapText="true"
                   visible="false" managed="false"/>

            <GridPane hgap="14" vgap="6">
                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                </columnConstraints>

                <Label text="NOMBRES *" styleClass="etiqueta" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="txtNombres" promptText="Nombres" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Label text="APELLIDOS *" styleClass="etiqueta" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <TextField fx:id="txtApellidos" promptText="Apellidos" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="USERNAME *" styleClass="etiqueta" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="txtUsername" promptText="Nombre de usuario único" styleClass="campo-mono"
                           GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <Label text="ROL *" styleClass="etiqueta" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                <ComboBox fx:id="cmbRol" promptText="Seleccione el rol" maxWidth="Infinity"
                          GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="CONTRASEÑA *" styleClass="etiqueta" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <PasswordField fx:id="txtClave" promptText="Contraseña" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            </GridPane>

            <HBox alignment="CENTER_RIGHT">
                <Button minWidth="-Infinity" fx:id="btnCrear" text="Crear usuario" styleClass="boton-primario" onAction="#crearUsuario"/>
            </HBox>
            <Label text="Las cuentas nuevas se crean activas." styleClass="etiqueta"/>
        </VBox>

        <!-- RF-14: activar o desactivar por username -->
        <VBox styleClass="panel" prefWidth="340" minWidth="300">
            <HBox styleClass="panel-cabecera">
                <Label text="Estado de una cuenta" styleClass="titulo-panel" minWidth="-Infinity"/>
            </HBox>
            <Label fx:id="lblMensajeEstado" styleClass="mensaje" maxWidth="Infinity" wrapText="true"
                   visible="false" managed="false"/>

            <Label text="USERNAME" styleClass="etiqueta"/>
            <TextField fx:id="txtUsernameEstado" promptText="Nombre de usuario" styleClass="campo-mono"/>

            <HBox spacing="10">
                <Button minWidth="-Infinity" fx:id="btnActivar" text="Activar" styleClass="boton-secundario"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#activar"/>
                <Button minWidth="-Infinity" fx:id="btnDesactivar" text="Desactivar" styleClass="boton-peligro"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#desactivar"/>
            </HBox>
            <Label text="Una cuenta inactiva no puede iniciar sesión hasta que se active de nuevo."
                   styleClass="etiqueta" wrapText="true"/>
        </VBox>
    </HBox>
</VBox>
