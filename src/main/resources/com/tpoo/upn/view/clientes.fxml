<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.tpoo.upn.gui.ClientesViewController" styleClass="contenido">

    <VBox styleClass="panel">
        <HBox spacing="8">
            <Label text="RECEPCIÓN" styleClass="chip"/>
        </HBox>
        <Label text="Clientes" styleClass="titulo-modulo"/>
        <Label text="Registre clientes, búsquelos por DNI y actualice sus nombres, apellidos y teléfono."
               styleClass="descripcion" wrapText="true"/>
    </VBox>

    <VBox styleClass="panel">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="txtBuscarDni" promptText="Buscar por DNI (8 dígitos)" styleClass="campo-mono"
                       HBox.hgrow="ALWAYS" onAction="#buscar"/>
            <Button minWidth="-Infinity" fx:id="btnBuscar" text="Buscar" styleClass="boton-secundario" onAction="#buscar"/>
            <Region HBox.hgrow="SOMETIMES" minWidth="10"/>
            <Button minWidth="-Infinity" text="Nuevo cliente" styleClass="boton-primario" onAction="#nuevoCliente"/>
        </HBox>
        <Label fx:id="lblMensajeBusqueda" styleClass="mensaje" maxWidth="Infinity" wrapText="true"
               visible="false" managed="false"/>
    </VBox>

    <HBox spacing="20">
        <!-- Lista de clientes: al elegir una fila se carga en el formulario -->
        <VBox styleClass="panel" HBox.hgrow="ALWAYS" minWidth="360">
            <HBox styleClass="panel-cabecera">
                <Label text="Clientes registrados" styleClass="titulo-panel" minWidth="-Infinity"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblTotal" styleClass="chip"/>
            </HBox>
            <TableView fx:id="tblClientes" prefHeight="380">
                <columns>
                    <TableColumn fx:id="colNombre" text="NOMBRES Y APELLIDOS" prefWidth="200"/>
                    <TableColumn fx:id="colDni" text="DNI" prefWidth="100"/>
                    <TableColumn fx:id="colTelefono" text="TELÉFONO" prefWidth="110"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
                <placeholder>
                    <Label fx:id="lblSinClientes" text=""/>
                </placeholder>
            </TableView>
            <Label text="Seleccione una fila para editar los datos del cliente." styleClass="etiqueta"/>
        </VBox>

        <!-- Formulario reutilizado para registrar y editar -->
        <VBox styleClass="panel" prefWidth="380" minWidth="320">
            <HBox styleClass="panel-cabecera">
                <Label fx:id="lblTituloFormulario" text="Nuevo cliente" styleClass="titulo-panel" minWidth="-Infinity"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblModo" text="REGISTRO" styleClass="chip"/>
            </HBox>
            <Label fx:id="lblMensaje" styleClass="mensaje" maxWidth="Infinity" wrapText="true"
                   visible="false" managed="false"/>

            <HBox>
                <Label text="DNI *" styleClass="etiqueta"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblNotaDni" text="No modificable al editar" styleClass="etiqueta"
                       visible="false" managed="false"/>
            </HBox>
            <TextField fx:id="txtDni" promptText="8 dígitos" styleClass="campo-mono"/>

            <Label text="NOMBRES *" styleClass="etiqueta"/>
            <TextField fx:id="txtNombres" promptText="Nombres"/>

            <Label text="APELLIDOS *" styleClass="etiqueta"/>
            <TextField fx:id="txtApellidos" promptText="Apellidos"/>

            <Label text="TELÉFONO (OPCIONAL)" styleClass="etiqueta"/>
            <TextField fx:id="txtTelefono" promptText="Teléfono" styleClass="campo-mono"/>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button minWidth="-Infinity" text="Cancelar" styleClass="boton-secundario" onAction="#nuevoCliente"/>
                <Button minWidth="-Infinity" fx:id="btnGuardar" text="Guardar cliente" styleClass="boton-primario" onAction="#guardar"/>
            </HBox>
        </VBox>
    </HBox>
</VBox>
