<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.tpoo.upn.gui.MembresiasViewController" styleClass="contenido">

    <VBox styleClass="panel">
        <HBox spacing="8">
            <Label text="RECEPCIÓN" styleClass="chip"/>
        </HBox>
        <Label text="Membresías" styleClass="titulo-modulo"/>
        <Label text="Consulte los períodos de un cliente y registre o renueve su membresía."
               styleClass="descripcion" wrapText="true"/>
    </VBox>

    <VBox styleClass="panel">
        <Label text="CLIENTE" styleClass="etiqueta"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="txtDni" promptText="DNI del cliente" styleClass="campo-mono"
                       prefWidth="170" minWidth="130" onAction="#buscarPorDni"/>
            <Button minWidth="-Infinity" fx:id="btnConsultar" text="Consultar" styleClass="boton-secundario" onAction="#buscarPorDni"/>
            <Label text="o" styleClass="descripcion"/>
            <ComboBox fx:id="cmbClientes" promptText="Seleccione un cliente de la lista"
                      maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#seleccionarDeLista"/>
        </HBox>
        <Label fx:id="lblMensajeCliente" styleClass="mensaje" maxWidth="Infinity" wrapText="true"
               visible="false" managed="false"/>
    </VBox>

    <HBox spacing="20">
        <VBox styleClass="panel" HBox.hgrow="ALWAYS" minWidth="410">
            <HBox styleClass="panel-cabecera">
                <Label text="Períodos de membresía" styleClass="titulo-panel" minWidth="-Infinity"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblClienteSeleccionado" text="SIN CLIENTE" styleClass="chip"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label fx:id="lblResumen" styleClass="etiqueta" wrapText="true"/>
                <Region HBox.hgrow="ALWAYS"/>
                <!-- Solo aparece si el cliente tiene periodos vencidos -->
                <CheckBox fx:id="chkHistorial" text="Mostrar historial" minWidth="-Infinity"
                          visible="false" managed="false" onAction="#cambiarHistorial"/>
            </HBox>
            <TableView fx:id="tblMembresias" prefHeight="300">
                <columns>
                    <TableColumn fx:id="colTipo" text="TIPO" prefWidth="150" minWidth="80"/>
                    <TableColumn fx:id="colInicio" text="INICIO" prefWidth="110" minWidth="90"/>
                    <TableColumn fx:id="colFin" text="VENCIMIENTO" prefWidth="110" minWidth="95"/>
                    <TableColumn fx:id="colEstado" text="ESTADO" prefWidth="130" minWidth="115"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
                <placeholder>
                    <Label fx:id="lblSinMembresias" text="Seleccione un cliente para ver sus membresías."/>
                </placeholder>
            </TableView>
            <Label text="El estado se calcula con la fecha de hoy: vigente, vencida o aún no vigente."
                   styleClass="etiqueta" wrapText="true"/>
        </VBox>

        <VBox styleClass="panel" prefWidth="320" minWidth="280">
            <HBox styleClass="panel-cabecera">
                <Label text="Registrar o renovar" styleClass="titulo-panel" minWidth="-Infinity"/>
            </HBox>
            <Label fx:id="lblMensaje" styleClass="mensaje" maxWidth="Infinity" wrapText="true"
                   visible="false" managed="false"/>

            <Label text="TIPO DE MEMBRESÍA" styleClass="etiqueta"/>
            <ComboBox fx:id="cmbTipos" promptText="Seleccione un tipo" maxWidth="Infinity"/>

            <Label text="FECHA DE INICIO" styleClass="etiqueta"/>
            <DatePicker fx:id="dpInicio" promptText="Seleccione la fecha" editable="false" maxWidth="Infinity"/>

            <Label text="FECHA DE VENCIMIENTO" styleClass="etiqueta"/>
            <DatePicker fx:id="dpFin" promptText="Seleccione la fecha" editable="false" maxWidth="Infinity"/>

            <HBox spacing="10">
                <Button minWidth="-Infinity" fx:id="btnRegistrar" text="Registrar membresía" styleClass="boton-primario"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#registrar"/>
                <Button minWidth="-Infinity" fx:id="btnRenovar" text="Renovar" styleClass="boton-secundario"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#renovar"/>
            </HBox>
            <Label text="Registrar: solo si el cliente no tiene una membresía vigente ni programada."
                   styleClass="etiqueta" wrapText="true"/>
            <Label text="Renovar: el período nuevo empieza después del último vencimiento y se suma a los anteriores (se sugiere el día siguiente). Los períodos no pueden cruzarse."
                   styleClass="etiqueta" wrapText="true"/>
        </VBox>
    </HBox>
</VBox>
