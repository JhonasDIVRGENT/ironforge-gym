<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.tpoo.upn.gui.TiposMembresiaViewController" styleClass="contenido">

    <VBox styleClass="panel">
        <HBox spacing="8">
            <Label text="ADMINISTRACIÓN" styleClass="chip"/>
        </HBox>
        <Label text="Tipos de membresía" styleClass="titulo-modulo"/>
        <Label text="Registre y consulte los tipos de membresía disponibles. El nombre debe ser único."
               styleClass="descripcion" wrapText="true"/>
    </VBox>

    <HBox spacing="20">
        <VBox styleClass="panel" HBox.hgrow="ALWAYS" minWidth="340">
            <HBox styleClass="panel-cabecera">
                <Label text="Tipos registrados" styleClass="titulo-panel" minWidth="-Infinity"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblTotal" styleClass="chip"/>
            </HBox>
            <TableView fx:id="tblTipos" prefHeight="320">
                <columns>
                    <TableColumn fx:id="colNombre" text="NOMBRE" prefWidth="220"/>
                    <TableColumn fx:id="colPrecio" text="PRECIO" prefWidth="120"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
                <placeholder>
                    <Label fx:id="lblSinTipos" text=""/>
                </placeholder>
            </TableView>
            <Label fx:id="lblMensajeLista" styleClass="mensaje" maxWidth="Infinity" wrapText="true"
                   visible="false" managed="false"/>
        </VBox>

        <VBox styleClass="panel" prefWidth="320" minWidth="280">
            <HBox styleClass="panel-cabecera">
                <Label text="Nuevo tipo" styleClass="titulo-panel" minWidth="-Infinity"/>
            </HBox>
            <Label fx:id="lblMensaje" styleClass="mensaje" maxWidth="Infinity" wrapText="true"
                   visible="false" managed="false"/>

            <Label text="NOMBRE *" styleClass="etiqueta"/>
            <TextField fx:id="txtNombre" promptText="Ej. Mensual"/>

            <Label text="PRECIO (S/) *" styleClass="etiqueta"/>
            <TextField fx:id="txtPrecio" promptText="Ej. 120.00" styleClass="campo-mono" onAction="#registrar"/>

            <Button minWidth="-Infinity" fx:id="btnRegistrar" text="Registrar tipo" styleClass="boton-primario"
                    maxWidth="Infinity" onAction="#registrar"/>
        </VBox>
    </HBox>
</VBox>
